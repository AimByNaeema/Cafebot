# Copy this file to .env and fill in real values. Never commit .env.

# Not yet used by the server — the /api/chat endpoint is currently a hardcoded
# placeholder and does not call the Anthropic API. Safe to leave blank for now.
# API key for the Anthropic (Claude) API CafeBot will use
ANTHROPIC_API_KEY=

# Claude model id to use for chat responses
CLAUDE_MODEL=claude-sonnet-5

# Port the backend server will run on
PORT=3000

# Sales tax rate applied to the order's taxable amount (subtotal minus discounts),
# as a decimal fraction — e.g. 0.08 for 8%. Default 0 (no tax).
TAX_RATE=0

# Flat delivery fee added to every order's total, in dollars — e.g. 2.50. Default 0 (no fee).
DELIVERY_FEE=0

# Optional: overrides where order records are read from/written to.
# Defaults to data/orders.json relative to the project root. Useful for pointing
# at a persistent volume on platforms with an ephemeral filesystem.
ORDERS_FILE_PATH=
